# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches ../docker-compose.yml defaults)
DATABASE_URL=postgres://rentcare:rentcare@localhost:5432/rentcare
# Deployed DB: injected from Infisical /postgres via scripts/with-secrets.sh (leave DATABASE_URL unset here).
# TLS: required for non-local hosts. DATABASE_SSL=disable only as a conscious, temporary exception.
# DATABASE_SSL=

# Shared bearer key the car app sends as `Authorization: Bearer <key>` (generate: openssl rand -base64 32)
CAR_API_KEY=change-me-car-api-key

# Staff login token for the demo vendor `demo-jeju` (stored only as a SHA-256 hash in the DB)
DEMO_VENDOR_TOKEN=change-me-staff-token

# Public origin of this server. ONE place for the host: the car app build reads it too.
# Now: Tailscale Funnel https://<machine>.<tailnet>.ts.net  → later: https://rentcare.devfor.link
# attachUrl in API responses is `${PUBLIC_BASE_URL}/m`.
# Falls back to the request origin when unset.
PUBLIC_BASE_URL=http://localhost:5173

# Private directory for uploaded files (must NOT be inside static/). Relative to the web/ dir.
STORAGE_DIR=./storage

# --- production (adapter-node) only ---
# Allow 50 MB uploads plus multipart overhead (adapter-node default is 512 KB).
BODY_SIZE_LIMIT=52M
# adapter-node derives the request origin from headers and assumes https unless told otherwise.
# Behind a TLS-terminating reverse proxy, forward these so SvelteKit's origin (CSRF) check works:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for   # so per-IP attempt limits see the real client IP
# PORT=3000
