<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: declare only the domains we read. -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />  <!-- Fuel, EvBattery -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- Odometer (range) -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />  <!-- Tire, Safety (telltales) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />    <!-- CarInfo capabilities -->

    <!-- Pleos NaviHelper -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />        <!-- get*Info, requestTrip -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" /> <!-- requestRoute(WithWaypoints) -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RentcareApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="${networkConfig}"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
          Not declared distraction-optimized. Whether a non-DO app is usable while driving depends on the
          regional policy, so the app also blocks detailed input itself via CarUxRestrictions (InputGate).
        -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
